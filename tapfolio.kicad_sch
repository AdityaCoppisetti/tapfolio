	)
	(text "this is the button layout , \nthis is just the wirring so that it looks neater, \nhowever you dont have to copy me exactly \nyou can just wire them as you want. this is just cleaner\n"
		(exclude_from_sim no)
		(at 123.19 147.32 0)
		(effects
			(font
				(size 1.016 1.016)
			)
		)
		(uuid "cc88c070-bab8-4b67-90c1-a3bbecfb640e")
	)
	(text " for the display\n"
		(exclude_from_sim no)
		(at 110.49 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "db3cf5ad-61f5-4e96-a93f-af31f451829a")
	)
	(text "PN532          Pico\nVCC   →     3V3(OUT)\nGND      →     GND\nMOSI     →     GP11\nMISO     →     GP12\nSCK      →     GP10\nSS (CS)  →     GP13\nIRQ      →     GP14\nRST      →     GP15"
		(exclude_from_sim no)
		(at 137.16 82.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f4954a7f-fcba-43fe-93b5-be0032bb01c4")
	)
	(text "for the nfc reader and writer\n(PN532)"
		(exclude_from_sim no)
		(at 111.76 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f9a8a719-b022-4dc7-9e5e-5c440bbb490e")
	)
	(text "The ST7735 display is used to provide a compact graphical user \ninterface for navigating links, \ndisplaying QR codes, and showing device status \nsuch as the selected profile and NFC activity."
		(exclude_from_sim no)
		(at 123.19 53.34 0)
		(effects
			(font
				(size 1.016 1.016)
			)
		)
		(uuid "ff599621-446b-4be7-acde-2525d8909630")
	)
